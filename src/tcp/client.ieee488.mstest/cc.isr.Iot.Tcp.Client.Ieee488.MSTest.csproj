    <!-- Assembly Info -->
    <RootNamespace>cc.isr.Iot.Tcp.Client.Ieee488</RootNamespace>
    <AssemblyName>cc.isr.Iot.Tcp.Client.Ieee488.MSTest</AssemblyName>

    <IsPackable>false</IsPackable>

  </PropertyGroup>

  <ItemGroup>
  </ItemGroup>

